# Firebase web config (from Step 4)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API
VITE_API_URL=http://localhost:8080

# MapboxGL token (from Step 9 below)
VITE_MAPBOX_TOKEN=

# Stripe (added later in Week 7)
VITE_STRIPE_PUBLIC_KEY=

# Recording / calibration UI (mobile owns these as of 2026-05-29; the
# webapp surfaces stay hidden in production until the mobile recorder
# reaches parity, after which the code is deleted). Set to "true"
# locally to expose the legacy recorder for dev testing. See
# sailline -docs/2026-05-29_mobile-ui-google-maps-mapping.md §2.
VITE_RECORDING_ENABLED=false